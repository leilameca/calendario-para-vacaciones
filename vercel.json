{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"npm run build:vercel",
  "outputDirectory":"public",
  "functions":{"api/calendar.mjs":{"maxDuration":60,"includeFiles":".vercel-build/**"}},
  "rewrites":[{"source":"/api/:path*","destination":"/api/calendar"},{"source":"/c/:token","destination":"/api/calendar"},{"source":"/admin/:path*","destination":"/api/calendar"},{"source":"/","destination":"/api/calendar"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"X-Content-Type-Options","value":"nosniff"}]}],
  "crons":[{"path":"/api/tick","schedule":"0 4 * * *"}]
}
